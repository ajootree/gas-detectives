// Prototype access rules for the quiz's anonymous leaderboard.
// gasQuizRuns/{uid}: mode (ranked enum), nonce (16..64 chars), startedAt (server timestamp).
// gasQuizScores/{mode_uid}: uid (immutable owner), mode, nonce, nickname (2..16 Korean/digits),
// score (30*completed), completed (1..100000), elapsedMs (positive int), updatedAt (server timestamp).
// Only generated nicknames and scores are public to signed-in guests; no personal profiles.
// These rules bound submissions and enforce ownership; they do not verify individual answers.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function rankedMode(mode) { return mode in ['marathon','sprint120']; }
    match /gasQuizRuns/{uid} {
      function validRun() {
        let d=request.resource.data;
        return d.keys().hasAll(['mode','nonce','startedAt'])
          && d.keys().hasOnly(['mode','nonce','startedAt'])
          && rankedMode(d.mode) && d.nonce is string
          && d.nonce.size() >= 16 && d.nonce.size() <= 64
          && d.startedAt is timestamp && d.startedAt == request.time;
      }
      allow get: if owner(uid);
      allow list: if false;
      allow create, update: if owner(uid) && validRun();
      allow delete: if owner(uid);
    }
    match /gasQuizScores/{id} {
      function validRecord() {
        let d=request.resource.data;
        let run=get(/databases/$(database)/documents/gasQuizRuns/$(request.auth.uid)).data;
        let elapsed=request.time.toMillis()-run.startedAt.toMillis();
        return d.keys().hasAll(['uid','mode','nonce','nickname','score','completed','elapsedMs','updatedAt'])
          && d.keys().hasOnly(['uid','mode','nonce','nickname','score','completed','elapsedMs','updatedAt'])
          && owner(d.uid) && id == d.mode+'_'+d.uid && rankedMode(d.mode)
          && d.mode == run.mode && d.nonce == run.nonce
          && d.nickname is string && d.nickname.size() >= 2 && d.nickname.size() <= 16
          && d.nickname.matches('^[가-힣0-9]+$')
          && d.score is int && d.completed is int && d.score == d.completed*30
          && d.completed >= 1 && d.completed <= 100000
          && d.elapsedMs is int && d.elapsedMs >= 1 && d.elapsedMs <= elapsed+1000
          && d.updatedAt == request.time
          && d.score <= elapsed*0.06
          && (d.mode != 'sprint120' || (elapsed >= 120000 && elapsed <= 300000 && d.score <= 7200));
      }
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 10;
      allow create: if request.auth != null && validRecord();
      allow update: if request.auth != null && validRecord()
        && resource.data.uid == request.auth.uid && request.resource.data.score > resource.data.score;
      allow delete: if owner(resource.data.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
